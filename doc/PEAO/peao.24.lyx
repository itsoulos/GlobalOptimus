\begin_layout Plain Layout
\begin_inset Caption Standard

\begin_layout Plain Layout
Effect of the Number of Clusters on Optimization Performance.
\begin_inset CommandInset label
LatexCommand label
name "fig:Impact-of-the"

\end_inset


\end_layout

\end_inset


\end_layout

